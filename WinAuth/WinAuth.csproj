<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>WinAuth.WinAuthMain</StartupObject>
    <ApplicationIcon>winauth.ico</ApplicationIcon>
    <Product>WinAuth</Product>
    <Description>WinAuth - The Windows Authenticator</Description>
    <Company>CTD Networks Co., Ltd.</Company>
    <Copyright>Copyright © 2013-2026 Colin Mackie / Modified 2026 CTD Networks Co., Ltd.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version Condition="'$(Version)' == ''">4.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);NETFX_4</DefineConstants>
    <NoWarn>$(NoWarn);WFO1000;WFDEV004;WFDEV006;CA1416;SYSLIB0014;SYSLIB0023;SYSLIB0060;NU1510;CS0618;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Authenticator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlRenderer.WinForms" Version="1.5.0.6" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Authenticator\Authenticator.csproj" />
    <ProjectReference Include="..\Third Party\InputSimulator\InputSimulator.csproj" />
    <ProjectReference Include="..\Third Party\MetroFramework\MetroFramework\MetroFramework.csproj" />
    <ProjectReference Include="..\Third Party\MetroFramework\MetroFramework.Fonts\MetroFramework.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\strings.*.resx;Resources\strings.resx" />
    <EmbeddedResource Include="Language\*.json" />
    <None Update="Language\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="winauth.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>