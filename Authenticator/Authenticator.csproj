<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WinAuth</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Product>WinAuth</Product>
    <Description>Authenticator implementation</Description>
    <Company>CTD Networks Co., Ltd.</Company>
    <Copyright>Copyright © 2013-2026 Colin Mackie / Modified 2026 CTD Networks Co., Ltd.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version Condition="'$(Version)' == ''">4.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);NETFX_4</DefineConstants>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014;SYSLIB0023;SYSLIB0060;CS8778;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.3.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\WinAuth.YubiKey.x64.dll" Condition="Exists('Resources\WinAuth.YubiKey.x64.dll')" />
    <EmbeddedResource Include="Resources\WinAuth.YubiKey.x86.dll" Condition="Exists('Resources\WinAuth.YubiKey.x86.dll')" />
  </ItemGroup>
</Project>